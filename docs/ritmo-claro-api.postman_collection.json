{
  "info": {
    "_postman_id": "85a71f87-b6fd-492d-93a0-862c0ce0de96",
    "name": "Ritmo Claro API - Taller Módulos 2 y 3",
    "description": "Colección completa de pruebas para la API de gestión de hábitos Ritmo Claro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "habitoId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "1.1 Registro Válido (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Pérez\",\n  \"email\": \"ana.perez@ritmoclaro.com\",\n  \"password\": \"PasswordSegura123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Registro con Email Duplicado (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Pérez Duplicada\",\n  \"email\": \"ana.perez@ritmoclaro.com\",\n  \"password\": \"PasswordSegura123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.3 Intento Inyección de Rol (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Hacker Intruso\",\n  \"email\": \"hacker@test.com\",\n  \"password\": \"PasswordSegura123!\",\n  \"rol\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.4 Login Válido (200 OK - Guarda Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.access_token) {",
                  "    pm.collectionVariables.set('token', response.access_token);",
                  "    console.log('Token guardado en variable {{token}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.perez@ritmoclaro.com\",\n  \"password\": \"PasswordSegura123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.5 Login Contraseña Incorrecta (401 Unauthorized)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.perez@ritmoclaro.com\",\n  \"password\": \"PasswordErrada999!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. CRUD de Hábitos (Protegido con JWT)",
      "item": [
        {
          "name": "2.1 Crear Hábito (201 Created - Guarda habitoId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.id) {",
                  "    pm.collectionVariables.set('habitoId', response.id);",
                  "    console.log('ID de hábito guardado en variable {{habitoId}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Pausas activas y estiramiento\",\n  \"descripcion\": \"10 minutos al aire libre después del almuerzo\",\n  \"frecuencia\": \"DIARIA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/habitos",
              "host": ["{{baseUrl}}"],
              "path": ["habitos"]
            }
          }
        },
        {
          "name": "2.2 Listar Hábitos Propios (200 OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habitos",
              "host": ["{{baseUrl}}"],
              "path": ["habitos"]
            }
          }
        },
        {
          "name": "2.3 Consultar Hábito Propio por ID (200 OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habitos/{{habitoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["habitos", "{{habitoId}}"]
            }
          }
        },
        {
          "name": "2.4 Modificar Parcialmente con PATCH (200 OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"PAUSADO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/habitos/{{habitoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["habitos", "{{habitoId}}"]
            }
          }
        },
        {
          "name": "2.5 Eliminar Hábito Propio (200 OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habitos/{{habitoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["habitos", "{{habitoId}}"]
            }
          }
        },
        {
          "name": "2.6 Confirmar Eliminación (404 Not Found)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habitos/{{habitoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["habitos", "{{habitoId}}"]
            }
          }
        }
      ]
    }
  ]
}
