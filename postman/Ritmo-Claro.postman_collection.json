                "exec": [
                  "pm.test('Status code es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('No expone passwordHash', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.not.have.property('passwordHash');",
