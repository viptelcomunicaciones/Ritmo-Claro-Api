              "host": ["{{baseUrl}}"],
              "path": ["habitos", "{{habitoId}}"]
            }
          }
        },
        {
          "name": "3.3 Usuario B intenta eliminar hábito de Usuario A (403 Forbidden)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habitos/{{habitoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["habitos", "{{habitoId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Roles y Administración (RBAC)",
      "item": [
        {
          "name": "4.1 Usuario Normal intenta listar todos los hábitos (403 Forbidden)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habitos/admin/todos",
              "host": ["{{baseUrl}}"],
              "path": ["habitos", "admin", "todos"]
            }
          }
        },
        {
          "name": "4.2 Administrador lista todos los hábitos globalmente (200 OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
