{
  "info": {
    "_postman_id": "a98e21bc-4521-4f12-9c31-ritmoclaro2026",
    "name": "Ritmo Claro API - Colección Oficial",
    "description": "Colección completa de pruebas para Ritmo Claro API. Incluye flujos positivos (camino feliz), negativos (validaciones), control de acceso por roles (RBAC) y control de propiedad de recursos (Ownership). Las variables baseUrl, token y adminToken están desacopladas y no contienen secretos vigentes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "habitoId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación (Público)",
      "item": [
        {
          "name": "1.1 Registro de Usuario Normal (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Mendoza\",\n  \"email\": \"carlos.mendoza@empresa.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Login de Usuario Normal (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('token', json.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos.mendoza@empresa.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Login de Administrador (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('adminToken', json.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ritmoclaro.com\",\n  \"password\": \"AdminPassword2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. CRUD de Hábitos (Usuario Regular)",
      "item": [
        {
          "name": "2.1 Crear Hábito (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('habitoId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Meditación y Mindfulness\",\n  \"descripcion\": \"Sesión de respiración antes de iniciar el trabajo\",\n  \"estado\": \"ACTIVO\",\n  \"frecuencia\": \"DIARIA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/habitos",
              "host": ["{{baseUrl}}"],
              "path": ["habitos"]
            }
          }
        },
        {
          "name": "2.2 Listar Hábitos Propios (200 OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habitos",
              "host": ["{{baseUrl}}"],
              "path": ["habitos"]
            }
          }
        },
        {
          "name": "2.3 Consultar Hábito Propio por ID (200 OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habitos/{{habitoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["habitos", "{{habitoId}}"]
            }
          }
        },
        {
          "name": "2.4 Actualizar Parcialmente Hábito Propio (200 OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"PAUSADO\",\n  \"descripcion\": \"Pausado temporalmente por semana de vacaciones\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/habitos/{{habitoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["habitos", "{{habitoId}}"]
            }
          }
        },
        {
          "name": "2.5 Eliminar Hábito Propio (200 OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habitos/{{habitoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["habitos", "{{habitoId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Control de Acceso y Propiedad (Ownership)",
      "item": [
        {
          "name": "3.1 Usuario B intenta consultar hábito de Usuario A (403 Forbidden)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habitos/{{habitoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["habitos", "{{habitoId}}"]
            }
          }
        },
        {
          "name": "3.2 Usuario B intenta modificar hábito de Usuario A (403 Forbidden)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
