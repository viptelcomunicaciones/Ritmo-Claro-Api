# ==============================================================================
# RITMO CLARO API — ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo a '.env' y completa los valores con tus credenciales.
# NUNCA incluyas contraseñas reales ni claves secretas en este archivo ni en Git.
# ==============================================================================

# Puerto de escucha del servidor HTTP
PORT=3000

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=production

# ------------------------------------------------------------------------------
# CONEXIÓN A BASE DE DATOS POSTGRESQL (Prisma ORM)
# ------------------------------------------------------------------------------
# Formato: postgresql://<USUARIO>:<PASSWORD>@<HOST>:<PUERTO>/<DATABASE>?schema=public
#
# Ejemplos según el entorno:
# - Local en Windows: postgresql://postgres:tu_password@localhost:5432/ritmo-claro?schema=public
# - Docker Desktop local (hacia Postgres de Windows): postgresql://postgres:tu_password@host.docker.internal:5432/ritmo-claro?schema=public
# - Despliegue en Dokploy (red interna): postgresql://postgres:password_dokploy@postgres-service:5432/ritmo_claro?schema=public
DATABASE_URL="postgresql://usuario_ejemplo:password_ejemplo@localhost:5432/ritmo_claro?schema=public"

# ------------------------------------------------------------------------------
# SEGURIDAD Y JSON WEB TOKENS (JWT)
# ------------------------------------------------------------------------------
# Clave criptográfica para firmar y verificar tokens HMAC-SHA256 (mínimo 32 caracteres).
# Genera una clave criptográfica segura en consola con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="reemplazar-con-un-secreto-criptografico-seguro-de-al-menos-32-caracteres"

# Tiempo de expiración del token de acceso (ej. '1h', '24h', '7d')
JWT_EXPIRES_IN="1h"
